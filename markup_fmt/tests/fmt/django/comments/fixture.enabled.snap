<!DOCTYPE html>
<html>
  <body>
    {# This is a comment #}
    {# This is a comment #}

    {# This is a comment with a lot of space around #}

    {# This is a very very very very very very very very very very very very long comment #}
    {# This is a very very very very very very very very very very very very long comment #}
    {# This is a very very very very very very very very very very very very long comment #}
    {% comment "commented-out template because we no longer use this" %}

        {% for user in users %}
            ...
        {% endfor %}

    {% endcomment %}
    {% comment %}
            Props:
              - form: AddStaffForm
    {% endcomment %}
  </body>
</html>
{% comment %}
    Props:
    - reviews: list[Review]

    Requirements:
        CSS & JS needed
        <link rel="stylesheet" href="...">
        <script src="..."></script>
{% endcomment %}

<div>
  <div>
    <div>
      {% comment %}{% if site_info.IS_RAVEN_INSTALLED %}
<script>Raven.config('{% sentry_public_dsn %}').install()</script>
    {% endif %}{% endcomment %}
    </div>
  </div>
</div>

<div>
  <div>
    <div>
      {% comment %}
{% if site_info.IS_RAVEN_INSTALLED %}
<script>Raven.config('{% sentry_public_dsn %}').install()</script>
{% endif %}
      {% endcomment %}
    </div>
  </div>
</div>

<div id="listing-results" hidden>
  {% comment %} Not implemented, hide content to avoid confusion {% endcomment %}
</div>

<button class="x" {% comment %}inline note{% endcomment %} type="button">
  y
</button>
<div>
  <button
    class="x"
    {% comment %}
    a note about the attribute below
    {% endcomment %}
    type="button"
  >
    y
  </button>
</div>
